# FlashDeal Radar — server tunables (all optional; defaults shown)

PORT=4000
MAX_URLS=10

# ── SSRF guard ──────────────────────────────────────────────
# Dev-only escape hatch: allow scraping loopback/private/link-local targets.
# NEVER set on a deployed instance.
ALLOW_PRIVATE_TARGETS=false

# ── Detection phase ─────────────────────────────────────────
DETECT_TIMEOUT_MS=12000
DETECT_CONCURRENCY=4

# ── Scrape phase ────────────────────────────────────────────
SCRAPE_CONCURRENCY=2
PER_HOST_CONCURRENCY=1
NAV_TIMEOUT_SECS=45
HANDLER_TIMEOUT_SECS=300
SCROLL_ROUNDS=14
MAX_LOAD_MORE_CLICKS=12
MAX_STALE_CLICKS=2
MAX_PAGES=5

# ── Product caps ────────────────────────────────────────────
# ⚠️ perState must be ≥ total: the per-state cap truncates each page state's
# extraction BEFORE merging; making it smaller silently drops products.
MAX_PRODUCTS_PER_STATE=200
MAX_PRODUCTS_TOTAL=200

# ── Cross-site matching ─────────────────────────────────────
MATCH_THRESHOLD=0.5
SAME_SITE_PENALTY=0.15
MAX_PRICE_RATIO=5

# ── Extraction quality (Phase 3) ────────────────────────────
# Below this 0..1 score the ladder escalates to the next rung and the
# better-scoring attempt wins; strategy-cache writes are gated on it too.
QUALITY_ESCALATE_BELOW=0.35

# ── Per-host strategy cache (Phase 4) ───────────────────────
STRATEGY_CACHE_TTL_DAYS=7

# ── Anti-block & politeness (Phase 5) ───────────────────────
# Proxy for the 'proxied' browser rung: http://user:pass@host:port
# Unset → the proxied rung is not in the ladder at all.
# PROXY_URL=
# Jittered inter-request delay window per host.
HOST_MIN_DELAY_MS=500
HOST_MAX_DELAY_MS=1500
# Honour robots.txt Disallow rules (err-open: unreachable robots = allowed).
# ROBOTS_OVERRIDE=true bypasses a robots refusal consciously.
RESPECT_ROBOTS=false
ROBOTS_OVERRIDE=false
