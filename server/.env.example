# FlashDeal Radar — server tunables (all optional; defaults shown)

PORT=4000
MAX_URLS=10

# ── SSRF guard ──────────────────────────────────────────────
# Dev-only escape hatch: allow scraping loopback/private/link-local targets.
# NEVER set on a deployed instance.
ALLOW_PRIVATE_TARGETS=false

# ── Detection phase ─────────────────────────────────────────
DETECT_TIMEOUT_MS=12000
DETECT_CONCURRENCY=4

# ── Scrape phase ────────────────────────────────────────────
SCRAPE_CONCURRENCY=2
PER_HOST_CONCURRENCY=1
NAV_TIMEOUT_SECS=45
HANDLER_TIMEOUT_SECS=300
SCROLL_ROUNDS=14
MAX_LOAD_MORE_CLICKS=12
MAX_STALE_CLICKS=2
MAX_PAGES=5

# ── Product caps ────────────────────────────────────────────
# ⚠️ perState must be ≥ total: the per-state cap truncates each page state's
# extraction BEFORE merging; making it smaller silently drops products.
MAX_PRODUCTS_PER_STATE=200
MAX_PRODUCTS_TOTAL=200

# ── Cross-site matching ─────────────────────────────────────
MATCH_THRESHOLD=0.5
SAME_SITE_PENALTY=0.15
MAX_PRICE_RATIO=5

# ── Extraction quality (Phase 3) ────────────────────────────
# Below this 0..1 score the ladder escalates to the next rung and the
# better-scoring attempt wins; strategy-cache writes are gated on it too.
QUALITY_ESCALATE_BELOW=0.35

# ── Per-host strategy cache (Phase 4) ───────────────────────
STRATEGY_CACHE_TTL_DAYS=7

# ── Anti-block & politeness (Phase 5) ───────────────────────
# Proxy for the 'proxied' browser rung: http://user:pass@host:port
# Unset → the proxied rung is not in the ladder at all.
# PROXY_URL=
# Jittered inter-request delay window per host.
HOST_MIN_DELAY_MS=500
HOST_MAX_DELAY_MS=1500
# Honour robots.txt Disallow rules (err-open: unreachable robots = allowed).
# ROBOTS_OVERRIDE=true bypasses a robots refusal consciously.
RESPECT_ROBOTS=false
ROBOTS_OVERRIDE=false

# ── Deal-page discovery (DISCOVERY_PLAN) ────────────────────
# Bounded best-first search over ONE registrable domain. Every cap is hard;
# exhaustion is a normal reported outcome, never an error.
DISCOVERY_MAX_FETCHES=20
DISCOVERY_MAX_MS=45000
DISCOVERY_MAX_CANDIDATES=120
DISCOVERY_MAX_VERIFY=6
# Top-K verified candidates that proceed to the full scrape ladder.
DISCOVERY_MAX_SCRAPE=3
# "enough()" for tier early-exit: this many candidates scoring >= 0.55.
DISCOVERY_MIN_CANDIDATES=4
DISCOVERY_MAX_DEPTH=1
DISCOVERY_MEMO_TTL_HOURS=12
# ── Verification gate (D4.2) — the tuning surface ──
# Fewer products than this ⇒ 'not-a-listing' (blog, landing page).
DISCOVERY_VERIFY_MIN_PRODUCTS=3
# Full accept needs at least this many products…
DISCOVERY_VERIFY_ACCEPT_PRODUCTS=8
# …plus quality >= escalateBelow, plus one of: dealDensity >= this…
DISCOVERY_VERIFY_DENSITY_ACCEPT=0.30
# Below this density AND a weak prior ⇒ 'no-discounts' reject.
DISCOVERY_VERIFY_DENSITY_REJECT=0.05
# …or a countdown timer… or a prior at least this strong.
DISCOVERY_VERIFY_STRONG_PRIOR=0.80
DISCOVERY_VERIFY_REJECT_PRIOR_FLOOR=0.75
# Verification extraction cap — enough to measure, cheap to get.
DISCOVERY_VERIFY_PRODUCT_CAP=60
# D9 graceful degradation: when no dedicated deal page clears the accept
# bar, verify up to this many top category listings from the nav…
DISCOVERY_FALLBACK_MAX_VERIFY=3
# …and keep any at least this deal-dense (their products are post-filtered
# to discounted-only, and the result is marked 'fallback:category-listing').
DISCOVERY_FALLBACK_MIN_DENSITY=0.15
# Discovery fetches are single cheap GETs — run below the scrape delay.
DISCOVERY_HOST_DELAY_MS=300
# Optional JSON file extending the keyword lexicon (add a language without
# a code change). Format: { "A": [], "B": [], "C": [], "BN": [], "NEG": [],
# "STOP": [], "SEASON": { "token": [1,12] } }
# DISCOVERY_LEXICON_PATH=
# ⚠️ Allow discovered URLs OUTSIDE the input's registrable domain (merchants
# hosting campaigns on a separate brand domain). This is the largest SSRF
# surface in the project — default OFF, loudly logged when ON.
DISCOVERY_ALLOW_CROSS_SITE=false

# ── Registry (D6) + autonomous refresh scheduler (D10) ──────
DISCOVERY_REGISTRY_MAX=5000
DISCOVERY_STALE_AFTER_HOURS=24
# AUTO_REFRESH=true enables unattended background fetching of the saved
# list. OFF by default — opt in consciously.
AUTO_REFRESH=false
REFRESH_TICK_MS=300000
REFRESH_PER_TICK=5
REFRESH_MIN_HOURS=1
REFRESH_MAX_HOURS=168
# Hard cap on browser-rung scrapes per hour (an unattended loop launching
# Chromium is a memory incident waiting to happen).
REFRESH_BROWSER_PER_HOUR=6
# This many consecutive check failures across DIFFERENT domains ⇒ the
# network is down, not the sites — pause for REFRESH_PAUSE_MS.
REFRESH_PAUSE_AFTER_FAILURES=3
REFRESH_PAUSE_MS=900000
